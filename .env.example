# Root .env — used by docker-compose (Postgres container).
# NOTE: the API reads its OWN env from packages/api/.env (Prisma/Nest run with
# their cwd there). Copy packages/api/.env.example -> packages/api/.env too.
DATABASE_URL="postgresql://cod:cod@localhost:5432/cod_tracker?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Courier API keys — server-side only, encrypted at rest. Stubbed in v1.
COURIER_ENCRYPTION_KEY="change-me-32-byte-hex-key-for-aes-256-gcm"

# API
PORT=3000
